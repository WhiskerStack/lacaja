# Conexión única a Postgres (sin pooler/doble-cadena de Supabase; stack §3).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dahemdb

# Secreto para firmar/verificar JWT (admin y cliente USER).
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Puerto HTTP del backend.
PORT=3000

# Orígenes permitidos por CORS (no '*'): el landing público y el panel admin.
LANDING_ORIGIN=http://localhost:4321
ADMIN_ORIGIN=http://localhost:5173

# Comando que regenera el SSG del landing al publicar (publish §7, MVP sin BullMQ).
# Regenera el landing (sync del catálogo desde este backend + astro build). Específico del
# despliegue: ajustar gestor/rutas. El swap del dist servido queda fuera de este comando.
BUILD_COMMAND=pnpm --dir ../Landing build
