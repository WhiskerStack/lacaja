# Conexión única a Postgres (sin pooler/doble-cadena de Supabase; stack §3).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/daher

# Secreto para firmar/verificar JWT (admin y cliente USER).
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Puerto HTTP del backend.
PORT=3000

# Orígenes permitidos por CORS (no '*'): el landing público y el panel admin.
LANDING_ORIGIN=http://localhost:4321
ADMIN_ORIGIN=http://localhost:5173

# Comando que regenera el SSG del landing al publicar (publish §7, MVP sin BullMQ).
# Placeholder: en producción apuntar al build real del landing.
BUILD_COMMAND=echo "[publish] building landing SSG..." && sleep 1 && echo "done"
