{
  "name": "@dahem/backend",
  "version": "0.1.0",
  "description": "Backend de Dahem (NestJS + Drizzle + Postgres). Frontera de escritura y generador del SSG.",
  "private": true,
  "scripts": {
    "start": "nest start -b swc",
    "start:dev": "nest start -b swc --watch",
    "dev": "nest start -b swc --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build -b swc",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "seed": "node -r @swc-node/register src/seed.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@dahem/domain": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/throttler": "^6.3.0",
    "@swc/cli": "^0.8.1",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "helmet": "^8.0.0",
    "nestjs-pino": "^4.2.0",
    "pg": "^8.13.1",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.10.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.28.1",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
