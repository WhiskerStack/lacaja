{
  "name": "dahem",
  "version": "0.1.0",
  "private": true,
  "description": "Landing público de Dahem: catálogo audiovisual de consulta (Astro SSG + islas Preact).",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "sync": "node scripts/sync-catalog.mjs && node scripts/enrich-catalog.mjs && node scripts/build-search-index.mjs",
    "enrich-catalog": "node scripts/enrich-catalog.mjs",
    "sync-catalog": "node scripts/sync-catalog.mjs",
    "check-enrichment": "node scripts/check-enrichment.mjs",
    "migrate-metadata": "node scripts/migrate-metadata.mjs",
    "build-search-index": "node scripts/build-search-index.mjs",
    "find-duplicates": "node scripts/find-duplicates.mjs",
    "translate-descriptions": "node scripts/translate-descriptions.mjs",
    "fix-title-languages": "node scripts/fix-title-languages.mjs",
    "disable-duplicates": "node scripts/disable-duplicates.mjs",
    "generate-pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --config=playwright.update.config.ts",
    "lint": "astro check"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@nanostores/persistent": "^0.10.2",
    "@nanostores/preact": "^0.5.2",
    "@preact/signals": "^2.0.1",
    "astro": "^5.1.1",
    "dexie": "^4.0.10",
    "lite-youtube-embed": "^0.3.3",
    "lucide-preact": "^0.460.0",
    "minisearch": "^7.1.1",
    "nanostores": "^0.11.3",
    "preact": "^10.25.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/preact": "^4.0.1",
    "@astrojs/tailwind": "^5.1.4",
    "@playwright/test": "^1.49.1",
    "@vite-pwa/astro": "^0.5.0",
    "daisyui": "^4.12.23",
    "dotenv": "^17.4.2",
    "fast-levenshtein": "^3.0.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "workbox-window": "^7.3.0",
    "xlsx": "^0.18.5"
  }
}
