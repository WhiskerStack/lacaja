{
  "name": "dahem",
  "version": "0.1.0",
  "private": true,
  "description": "Dahem — catálogo audiovisual de consulta (landing SSG + panel admin + backend). Monorepo.",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:domain": "pnpm --filter @dahem/domain build",
    "dev:backend": "pnpm --filter @dahem/backend start:dev",
    "dev:landing": "pnpm --filter @dahem/landing dev",
    "dev:admin": "pnpm --filter @dahem/admin dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "license": "MIT"
}
