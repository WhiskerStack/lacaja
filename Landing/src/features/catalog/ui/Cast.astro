---
// Reparto (funcional §6.2.4): solo los nombres de los actores principales.
interface Props {
  cast: string[];
}
const { cast } = Astro.props;
---
{cast.length > 0 && (
  <section class="my-8">
    <h2 class="text-lg sm:text-xl font-bold mb-3">Reparto</h2>
    <div class="flex flex-wrap gap-2">
      {cast.map((name) => <span class="badge badge-lg badge-outline">{name}</span>)}
    </div>
  </section>
)}
