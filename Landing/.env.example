# URL del backend NestJS para fallback de búsqueda, pricing y escrituras (auth, envío por web).
# En build-time el catálogo se lee del JSON de muestra; el API solo se usa en runtime.
PUBLIC_API_URL=http://localhost:3000/api

# Número de WhatsApp del negocio (formato internacional sin '+', para wa.me).
PUBLIC_WHATSAPP_NUMBER=5350000000

# URL pública del sitio (usada por Astro para canonical, sitemap, etc.).
SITE=https://daher.example
