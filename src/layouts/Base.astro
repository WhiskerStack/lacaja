---
// Layout base: navbar, banner de red, drawer/modales globales, botonera inferior y host de toasts.
// Las islas globales viven aquí una sola vez y reaccionan vía nanostores en cualquier página.
import "../styles/global.css";
import Navbar from "../app/ui/Navbar.tsx";
import BottomBar from "../app/ui/BottomBar.tsx";
import ToastHost from "../app/ui/ToastHost.tsx";
import Drawer from "../features/my-list/ui/Drawer.tsx";
import SubmissionModal from "../features/submission/ui/SubmissionModal.tsx";
import { stripBase, withBase } from "../shared/urls";

declare const __DAHEM_BUILD__: string;
const buildMarker =
  typeof __DAHEM_BUILD__ !== "undefined" ? __DAHEM_BUILD__ : "dev";

interface Props {
  title?: string;
  description?: string;
  /** Detalle móvil oculta el navbar (funcional §6.2.1). */
  hideChrome?: boolean;
}
const {
  title = "La Caja — Catálogo audiovisual",
  description = "Catálogo de consulta. Arma tu lista y envíala al negocio.",
  hideChrome = false,
} = Astro.props;

// Ruta actual: las barras de navegación la usan para resaltar la sección activa.
const pathname = stripBase(Astro.url.pathname);
---

<!doctype html>
<html lang="es" data-theme="dahemdark">
  <head>
    <meta charset="UTF-8" />
    <meta name="build-marker" content={buildMarker} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f17" />
    <link rel="manifest" href={withBase("/manifest.webmanifest")} />
    <!-- Prefetch del índice de búsqueda en todas las páginas (especificaciones §4.2) -->
    <link
      rel="prefetch"
      href={withBase("/search-index.json")}
      as="fetch"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <title>{title}</title>
  </head>
  <body>
    {!hideChrome && <Navbar client:load pathname={pathname} />}

    <main class="max-w-content mx-auto px-3 sm:px-4 pb-24 md:pb-10">
      <slot />
    </main>

    {!hideChrome && <BottomBar client:load pathname={pathname} />}

    <!-- Islas globales (drawer + modales + toasts) -->
    <Drawer client:idle />
    <SubmissionModal client:idle />
    <ToastHost client:idle />

    <!-- Publica el alto real del navbar en `--navbar-h` para que las barras
         pegajosas de cada página (filtros de Biblioteca) se sitúen justo debajo. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const header = document.querySelector("header.navbar");
        const sync = () => {
          root.style.setProperty(
            "--navbar-h",
            (header ? header.offsetHeight : 0) + "px",
          );
        };
        sync();
        if (header && "ResizeObserver" in window)
          new ResizeObserver(sync).observe(header);
        else window.addEventListener("resize", sync);
      })();
    </script>

    <!-- Restauración de posición al volver atrás (scroll de página y de carruseles). -->
    <script>
      import { installNavRestore } from "../shared/nav-state";
      installNavRestore();
    </script>

    <!-- Registro del service worker (autoUpdate).

         vite-plugin-pwa inyecta su script con el hook transformIndexHtml de Vite,
         y Astro no pasa por ahí las páginas que genera: hay que registrarlo a mano.
         Sin esto la PWA se instala pero no cachea nada.

         Flujo con registerType: 'autoUpdate' (ver astro.config.mjs):

           1. El navegador detecta un sw.js nuevo → lo instala en background.
           2. El SW nuevo precachea solo el HTML cuyo revision cambió (manifest de
              Workbox). Los _astro/* NO están en el precache: viven en el HTTP
              cache con `Cache-Control: immutable` 1 año (staticwebapp.config.json)
              y en `dahem-assets` vía la regla runtime.
           3. skipWaiting + clients.claim → el SW nuevo toma el control.
           4. `controllerchange` se dispara y recargamos la pestaña para que el
              usuario vea el HTML y los bundles nuevos.

         El flag `refreshing` evita doble reload si el evento se dispara más de
         una vez durante el ciclo de activación.

         Comprobación periódica de update: los móviles (sobre todo iOS en modo
         standalone) throttlean el chequeo automático del SW. Forzamos `reg.update()`
         cada hora y también al volver a primer plano, que es cuando el usuario
         realmente va a interactuar con la app. -->
    <script>
      import { registerSW } from "virtual:pwa-register";

      const hadController = Boolean(navigator.serviceWorker.controller);
      let refreshing = false;
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.addEventListener("controllerchange", () => {
          // Sin controller previo = primera instalación (clients.claim nos controla
          // ahora, pero el HTML ya es el nuevo): no recargamos.
          // Con controller previo = reemplazo de SW: el HTML servido puede ser viejo,
          // recargamos para que el usuario vea los bundles nuevos.
          if (!hadController || refreshing) return;
          refreshing = true;
          window.location.reload();
        });
      }

      registerSW({
        immediate: true,
        onOfflineReady() {
          // Primer arranque offline listo. Opcional: mostrar un toast la primera
          // vez que el catálogo queda disponible sin conexión.
        },
        onRegisterError(err) {
          console.error("[pwa] registro del SW falló:", err);
        },
      });

      navigator.serviceWorker?.ready
        .then((reg) => {
          const check = () => reg.update().catch(() => {});
          setInterval(check, 60 * 60 * 1000);
          document.addEventListener("visibilitychange", () => {
            if (document.visibilityState === "visible") check();
          });
        })
        .catch(() => {});
    </script>
  </body>
</html>
