---
// Layout base: navbar, banner de red, drawer/modales globales, botonera inferior y host de toasts.
// Las islas globales viven aquí una sola vez y reaccionan vía nanostores en cualquier página.
import "../styles/global.css";
import Navbar from "../app/ui/Navbar.tsx";
import BottomBar from "../app/ui/BottomBar.tsx";
import ToastHost from "../app/ui/ToastHost.tsx";
import Drawer from "../features/my-list/ui/Drawer.tsx";
import SubmissionModal from "../features/submission/ui/SubmissionModal.tsx";

interface Props {
  title?: string;
  description?: string;
  /** Detalle móvil oculta el navbar (funcional §6.2.1). */
  hideChrome?: boolean;
}
const {
  title = "La Caja — Catálogo audiovisual",
  description = "Catálogo de consulta. Arma tu lista y envíala al negocio.",
  hideChrome = false,
} = Astro.props;

// Ruta actual: las barras de navegación la usan para resaltar la sección activa.
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="es" data-theme="dahemdark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f17" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Prefetch del índice de búsqueda en todas las páginas (especificaciones §4.2) -->
    <link
      rel="prefetch"
      href="/search-index.json"
      as="fetch"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    {!hideChrome && <Navbar client:load pathname={pathname} />}

    <main class="max-w-content mx-auto px-3 sm:px-4 pb-24 md:pb-10">
      <slot />
    </main>

    {!hideChrome && <BottomBar client:load pathname={pathname} />}

    <!-- Islas globales (drawer + modales + toasts) -->
    <Drawer client:idle />
    <SubmissionModal client:idle />
    <ToastHost client:idle />

    <!-- Publica el alto real del navbar en `--navbar-h` para que las barras
         pegajosas de cada página (filtros de Biblioteca) se sitúen justo debajo. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const header = document.querySelector('header.navbar');
        const sync = () => {
          root.style.setProperty('--navbar-h', (header ? header.offsetHeight : 0) + 'px');
        };
        sync();
        if (header && 'ResizeObserver' in window) new ResizeObserver(sync).observe(header);
        else window.addEventListener('resize', sync);
      })();
    </script>

    <!-- Restauración de posición al volver atrás (scroll de página y de carruseles). -->
    <script>
      import { installNavRestore } from "../shared/nav-state";
      installNavRestore();
    </script>

    <!-- Registro del service worker (soporte offline + actualización de versión).
         Hay que hacerlo a mano: vite-plugin-pwa inyecta su script con el hook
         transformIndexHtml de Vite, y Astro no pasa por ahí las páginas que
         genera, así que sin esto la PWA se instala pero no cachea nada.

         Sobre actualizaciones: `registerType` en astro.config.mjs decide la
         estrategia.

           'autoUpdate'  → el SW nuevo se activa solo (skipWaiting + clients.claim).
                           Aquí recargamos la pestaña al recibir `controllerchange`,
                           porque sin ese reload el usuario sigue viendo el JS/HTML
                           viejo aunque el SW ya esté actualizado.

           'prompt'      → el SW nuevo queda en estado `waiting`. `onNeedRefresh` se
                           dispara y mostramos un banner con "Actualizar"; al
                           pulsarlo se llama a updateSW(true), que hace skipWaiting
                           y recarga.

         En ambos modos el listener de `controllerchange` garantiza que la pestaña
         no se quede con la versión vieja. El flag `refreshing` evita doble reload.

         Nota: no usamos pushToast aquí porque este <script> y la isla ToastHost
         son bundles separados; el atom de nanostores sería una instancia distinta
         y el toast nunca aparecería. El banner se pinta con DOM puro. -->
    <script>
      import { registerSW } from "virtual:pwa-register";

      let refreshing = false;
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.addEventListener("controllerchange", () => {
          if (refreshing) return;
          refreshing = true;
          window.location.reload();
        });
      }

      const updateSW = registerSW({
        immediate: true,
        onNeedRefresh() {
          // Solo se llama con registerType: 'prompt'. Con 'autoUpdate' esta rama
          // nunca se ejecuta y el controllerchange de arriba hace el trabajo.
          showUpdateBanner(() => {
            refreshing = true; // evita que controllerchange recargue de nuevo
            updateSW(true);
          });
        },
        onOfflineReady() {
          // Primer arranque offline listo. Opcional: mostrar solo la primera vez.
        },
      });

      /**
       * Banner fijo abajo con botón "Actualizar". DOM puro a propósito: este
       * script corre en su propio bundle y no comparte el atom de toasts con la
       * isla ToastHost, así que pushToast no funcionaría aquí.
       */
      function showUpdateBanner(onAccept: () => void) {
        if (document.getElementById("dahem-update-banner")) return;
        const banner = document.createElement("div");
        banner.id = "dahem-update-banner";
        banner.setAttribute("role", "status");
        banner.setAttribute("aria-live", "polite");
        banner.style.cssText = [
          "position:fixed",
          "left:50%",
          "bottom:1rem",
          "transform:translateX(-50%)",
          "z-index:9999",
          "display:flex",
          "align-items:center",
          "gap:.75rem",
          "padding:.625rem .75rem .625rem 1rem",
          "background:#111827",
          "color:#e5e7eb",
          "border:1px solid #1c2230",
          "border-radius:.75rem",
          "box-shadow:0 10px 30px rgba(0,0,0,.45)",
          "font:500 .875rem/1.2 Inter,system-ui,sans-serif",
          "max-width:calc(100vw - 2rem)",
        ].join(";");

        const msg = document.createElement("span");
        msg.textContent = "Hay una versión nueva disponible.";
        banner.appendChild(msg);

        const accept = document.createElement("button");
        accept.type = "button";
        accept.textContent = "Actualizar";
        accept.style.cssText = [
          "background:#e11d48",
          "color:#fff",
          "border:0",
          "border-radius:.5rem",
          "padding:.375rem .75rem",
          "font:600 .8125rem/1 Inter,system-ui,sans-serif",
          "cursor:pointer",
        ].join(";");
        accept.addEventListener("click", () => {
          banner.remove();
          onAccept();
        });
        banner.appendChild(accept);

        document.body.appendChild(banner);
      }

      // Comprobación periódica de update: los móviles (sobre todo iOS en modo
      // standalone) throttlean el chequeo automático del SW. Forzamos una
      // comprobación cada hora y también al volver a primer plano, que es
      // cuando el usuario realmente va a interactuar con la app.
      navigator.serviceWorker?.ready
        .then((reg) => {
          const check = () => reg.update().catch(() => {});
          setInterval(check, 60 * 60 * 1000);
          document.addEventListener("visibilitychange", () => {
            if (document.visibilityState === "visible") check();
          });
        })
        .catch(() => {});
    </script>
  </body>
</html>