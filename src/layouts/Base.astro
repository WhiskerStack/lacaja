---
// Layout base: navbar, banner de red, drawer/modales globales, botonera inferior y host de toasts.
// Las islas globales viven aquí una sola vez y reaccionan vía nanostores en cualquier página.
import "../styles/global.css";
import Navbar from "../app/ui/Navbar.tsx";
import BottomBar from "../app/ui/BottomBar.tsx";
import ToastHost from "../app/ui/ToastHost.tsx";
import Drawer from "../features/my-list/ui/Drawer.tsx";
import SubmissionModal from "../features/submission/ui/SubmissionModal.tsx";

interface Props {
  title?: string;
  description?: string;
  /** Detalle móvil oculta el navbar (funcional §6.2.1). */
  hideChrome?: boolean;
}
const {
  title = "La Caja — Catálogo audiovisual",
  description = "Catálogo de consulta. Arma tu lista y envíala al negocio.",
  hideChrome = false,
} = Astro.props;

// Ruta actual: las barras de navegación la usan para resaltar la sección activa.
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="es" data-theme="dahemdark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f17" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Prefetch del índice de búsqueda en todas las páginas (especificaciones §4.2) -->
    <link
      rel="prefetch"
      href="/search-index.json"
      as="fetch"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    {!hideChrome && <Navbar client:load pathname={pathname} />}

    <main class="max-w-content mx-auto px-3 sm:px-4 pb-24 md:pb-10">
      <slot />
    </main>

    {!hideChrome && <BottomBar client:load pathname={pathname} />}

    <!-- Islas globales (drawer + modales + toasts) -->
    <Drawer client:idle />
    <SubmissionModal client:idle />
    <ToastHost client:idle />

    <!-- Publica el alto real del navbar en `--navbar-h` para que las barras
         pegajosas de cada página (filtros de Biblioteca) se sitúen justo debajo. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const header = document.querySelector('header.navbar');
        const sync = () => {
          root.style.setProperty('--navbar-h', (header ? header.offsetHeight : 0) + 'px');
        };
        sync();
        if (header && 'ResizeObserver' in window) new ResizeObserver(sync).observe(header);
        else window.addEventListener('resize', sync);
      })();
    </script>

    <!-- Restauración de posición al volver atrás (scroll de página y de carruseles). -->
    <script>
      import { installNavRestore } from "../shared/nav-state";
      installNavRestore();
    </script>
  </body>
</html>
