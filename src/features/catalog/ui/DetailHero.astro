---
// Hero del detalle (funcional §6.2.2): foto de fondo + nombre, género, duración, rating,
// descripción y el botón "Agregar a Mi lista" (isla).
import { Image } from "astro:assets";
import AddToListButton from "./AddToListButton.tsx";
import { formatDuration, formatRating, truncate } from "../../../shared/format";
import { TYPE_LABEL } from "../types";
import type { CatalogItemDTO } from "../types";
import { PLACEHOLDER_IMAGE } from "@/shared/urls";

interface Props {
  item: CatalogItemDTO;
  /** Nivel a agregar (audiovisual/season/episode) con su código, nombre y nº de capítulos. */
  add: {
    code: string;
    level: "audiovisual" | "season" | "episode";
    targetId: string;
    name: string;
    sizeGb: number;
    units?: number;
  };
  /** Subtítulo opcional para temporada/capítulo. */
  context?: string;
  /** Destino del botón "Atrás" cuando no hay historial propio (enlace compartido). */
  backHref?: string;
}
const { item, add, context, backHref = "/" } = Astro.props;
const limit = 240;
const longDescription = item.description.length > limit;
const hasImage = Boolean(item.imageUrl);
const imageSrc = hasImage ? item.imageUrl : PLACEHOLDER_IMAGE;
---

<section
  class="relative w-screen left-1/2 -translate-x-1/2 min-h-[70vh] flex items-end"
>
  <Image
    src={imageSrc}
    alt={item.name}
    width={1200}
    height={1800}
    loading="eager"
    class="absolute inset-0 w-full h-full object-cover"
  />
  <div
    class="absolute inset-0 bg-gradient-to-t from-base-100 via-base-100/80 to-base-100/20"
  >
  </div>

  {/* Atrás explícito: en la PWA instalada (display standalone) no hay barra del navegador. */}
  <a
    href={backHref}
    data-detail-back
    class="btn btn-circle btn-sm sm:btn-md bg-base-100/70 hover:bg-base-100 border-none absolute top-4 left-4 z-10"
    aria-label="Volver"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m15 18-6-6 6-6"></path>
    </svg>
  </a>

  <div class="relative max-w-content mx-auto w-full p-6 sm:p-10 pb-4 sm:pb-6">
    {
      context && (
        <p class="text-sm text-secondary font-semibold mb-1">{context}</p>
      )
    }
    <h1
      class:list={[
        "text-3xl sm:text-5xl font-extrabold",
        item.altName ? "mb-1" : "mb-3",
      ]}
    >
      {item.name}
    </h1>
    {
      item.altName && (
        <p class="text-base sm:text-lg opacity-70 mb-3">
          <span class="font-semibold">{item.altName}</span>
        </p>
      )
    }

    <div class="flex flex-wrap gap-2 items-center text-sm mb-4">
      <span class="badge badge-primary">★ {formatRating(item.rating)}</span>
      <span class="opacity-90">{TYPE_LABEL[item.type]}</span>
      {item.genres.map((g) => <span class="opacity-90">· {g}</span>)}
      <span class="opacity-90">· {item.year}</span>
      {
        item.durationMin ? (
          <span class="opacity-90">· {formatDuration(item.durationMin)}</span>
        ) : null
      }
      {
        item.type !== "movie" && (
          <span class="opacity-90">
            · {item.seasonCount} temporadas · {item.episodeCount} capítulos
          </span>
        )
      }
      {item.isPremiere && <span class="badge badge-secondary">Estreno</span>}
      <span class="badge badge-outline">Doblado al español</span>
    </div>

    {longDescription ? (
      <details class="max-w-2xl mb-10 sm:mb-8 desc-details">
        <summary class="cursor-pointer list-none opacity-90">
          <span class="truncated">{truncate(item.description, limit)}</span>
          <span class="full">{item.description}</span>
          <span class="toggle-label text-primary"></span>
        </summary>
      </details>
    ) : (
      <p class="max-w-2xl mb-10 sm:mb-8 opacity-90">{item.description}</p>
    )}

    <AddToListButton
      client:visible
      code={add.code}
      level={add.level}
      targetId={add.targetId}
      name={add.name}
      sizeGb={0}
      type={item.type}
      isPremiere={item.isPremiere}
      units={add.units ?? 1}
    />
  </div>
</section>

<script>
  // El enlace funciona sin JS (href al nivel superior); con JS se prefiere el historial real
  // para devolver al usuario a la vista y el scroll exactos de donde vino.
  import { goBack } from "../../../shared/nav-state";

  document
    .querySelectorAll<HTMLAnchorElement>("a[data-detail-back]")
    .forEach((el) => {
      el.addEventListener("click", (event) => {
        event.preventDefault();
        goBack(el.getAttribute("href") ?? "/");
      });
    });
</script>
