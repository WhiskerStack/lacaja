---
// Detalle de película /p/[id] (funcional §6.2). getStaticPaths genera una página por película.
import Base from '../../layouts/Base.astro';
import DetailHero from '../../features/catalog/ui/DetailHero.astro';
import Trailers from '../../features/catalog/ui/Trailers.astro';
import Cast from '../../features/catalog/ui/Cast.astro';
import Rail from '../../features/catalog/ui/Rail.astro';
import { getMovies, getById, getSuggestions } from '../../features/catalog/logic/buildData';

export function getStaticPaths() {
  return getMovies().map((m) => ({ params: { id: String(m.id) }, props: { id: m.id } }));
}

const { id } = Astro.props as { id: number };
const item = getById(id);
if (!item) return Astro.redirect('/404');
const suggestions = getSuggestions(item);
---
<Base title={`${item.name} — Dahem`} description={item.description}>
  <DetailHero
    item={item}
    add={{ code: item.code, level: 'audiovisual', targetId: item.id, name: item.name, sizeGb: item.totalSizeGb }}
  />
  <Trailers youtubeIds={item.trailers} />
  <Cast cast={item.cast} />
  <Rail title="Sugerencias" cards={suggestions} />
</Base>
