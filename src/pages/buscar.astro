---
// Buscar (funcional §6.4): la isla usa el índice MiniSearch local (o fallback API). Recibe las
// cards del catálogo por SSG para resolver foto/año/tipo a partir del código del índice.
import Base from '../layouts/Base.astro';
import SearchView from '../features/search/ui/SearchView.tsx';
import { getCards } from '../features/catalog/logic/buildData';
import { withLocalImages, POSTER_SIZE } from '../features/catalog/logic/cardImages';

// Igual que en biblioteca: la isla necesita rutas locales, no las de TMDB.
const cards = await withLocalImages(getCards(), POSTER_SIZE);
---
<Base title="Buscar — La Caja">
  <h1 class="text-2xl font-bold my-4">Buscar</h1>
  <SearchView client:load cards={cards} />
</Base>
